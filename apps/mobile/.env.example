# Supabase — get from https://app.supabase.com/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# IMPORTANT: NEVER prefix the service role key with EXPO_PUBLIC_
# It would be embedded in the JS bundle and visible to anyone with the binary.
# All service-role operations must go through apps/admin server routes or Edge Functions.

# Mapbox — public token (map rendering only — does NOT give write access)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# RevenueCat — platform-specific public API keys
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_your_ios_api_key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_your_android_api_key
