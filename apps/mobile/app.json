{
  "expo": {
    "name": "Water Potty",
    "slug": "watty",
    "version": "1.0.0",
    "scheme": "waterpotty",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.waterpotty.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Water Potty uses your location to show nearby washrooms and to verify new washroom submissions from the community.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Water Potty uses your location to show nearby washrooms and to verify new washroom submissions from the community."
      }
    },
    "android": {
      "package": "com.waterpotty.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Water Potty uses your location to show nearby washrooms and to verify new washroom submissions from the community."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#007aff"
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "$(MAPBOX_SECRET_TOKEN)"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "768377a0-4d55-4352-8059-0e16cb6bb809"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "watty_yvr"
  }
}
