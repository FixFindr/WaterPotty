{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@water-potty/db": [
        "../../packages/db/index.ts"
      ],
      "@water-potty/shared": [
        "../../packages/shared/index.ts"
      ],
      "@water-potty/ui": [
        "../../packages/ui/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
