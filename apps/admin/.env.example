# Supabase — get from https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Service role key — NEVER expose to client-side code. Server/API routes only.
# This key bypasses ALL Row Level Security policies.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Mapbox — get from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
